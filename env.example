# ConnectX Chatbot Environment Configuration
# Default backend: ollama (runs locally, free, no API key needed)
LLM_BACKEND=ollama
MAIN_MODEL=phi3:latest
ROUTER_MODEL=phi3:latest

# To use Anthropic Claude:
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# MAIN_MODEL=claude-3-5-sonnet-20241022
# ROUTER_MODEL=claude-3-5-haiku-20241022

# To use OpenAI:
# LLM_BACKEND=openai
# OPENAI_API_KEY=your-openai-key-here
# MAIN_MODEL=gpt-4o-mini
# ROUTER_MODEL=gpt-4o-mini

# To use xAI Grok:
# LLM_BACKEND=xai
# XAI_API_KEY=your-xai-key-here
# MAIN_MODEL=grok-2-mini
# ROUTER_MODEL=grok-2-mini
